# Salin ke /etc/laporan/laporan-ocr.env lalu sesuaikan.
# Dibaca oleh laporan-ocr.service.

# Wajib False. PaddlePaddle 3.3.1 gagal di Windows bila MKLDNN aktif, dan
# server Linux tetap memakai jalur yang sama agar perilakunya konsisten.
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False

# Bahasa model. `id` memakai model Latin (PP-OCRv6 medium pada PaddleOCR 3.7).
LAPORAN_PADDLE_LANG=id

# Sisi terpanjang gambar setelah diperkecil. Turunkan ke 1600 bila CPU VPS
# terbatas; naikkan ke 2560 bila watermark kecil sering tidak terbaca.
LAPORAN_PADDLE_MAX_SIDE=1920

# 0 berarti semua baris dipakai. Isi 0.3 untuk membuang baris skor rendah.
LAPORAN_PADDLE_MIN_SCORE=0

# Lama menunggu model selesai dimuat sebelum permintaan pertama dilayani.
LAPORAN_PADDLE_READY_TIMEOUT=180

# Model Paddle disimpan di $HOME/.paddlex. Pastikan direktori ini dapat ditulis
# oleh user `laporan` dan sesuaikan dengan LAPORAN_DATA_DIR milik backend.
HOME=/home/laporan-data
