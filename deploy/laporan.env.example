# Salin ke /etc/laporan/laporan.env lalu sesuaikan.
LAPORAN_DATA_DIR=/var/lib/laporan
LAPORAN_FRONTEND_DIR=/opt/laporan/frontend/dist
LAPORAN_PORT=4317
# Default loopback. Isi 0.0.0.0 hanya jika tidak memakai reverse proxy.
# LAPORAN_BIND_ADDR=127.0.0.1
# Saat bind non-loopback, batasi host yang boleh diakses (pisahkan dengan koma).
# Gunakan * hanya untuk uji sementara.
# LAPORAN_ALLOWED_HOSTS=laporan.example.go.id,192.168.1.10
LAPORAN_CHROME=/usr/bin/google-chrome-stable
# Tesseract untuk analisis dokumentasi (OCR watermark).
LAPORAN_TESSERACT=tesseract
# Opsional: sidecar PaddleOCR. Aktifkan setelah laporan-ocr.service berjalan;
# tanpa sidecar, analisis hanya memakai Tesseract.
# LAPORAN_PADDLE_URL=http://127.0.0.1:4320
LAPORAN_PADDLE_TIMEOUT_SECS=120
LAPORAN_SECURE_COOKIE=true
LAPORAN_POLDA_NAME=POLDA BALI
LAPORAN_TIMEZONE_LABEL=WITA
# Profil peta laporan: bali atau jateng.
LAPORAN_MAP_REGION=bali
# Opsional. Logo instansi untuk web dan PDF. Bila kosong, dipakai
# <LAPORAN_DATA_DIR>/logo.png lalu logo bawaan aplikasi.
# LAPORAN_LOGO_PATH=/home/laporan-data/logo.png
LAPORAN_MAX_UPLOAD_MB=32
LAPORAN_SESSION_HOURS=12
# Opsional. Wajib untuk tautan folder Google Drive publik.
# Isi API key asli hanya di /etc/laporan/laporan.env, jangan di file contoh ini.
LAPORAN_GOOGLE_DRIVE_API_KEY=
# Bukti dukung baris yang kalah deduplikasi langsung dibersihkan (0 hari).
# Naikkan bila ingin menyimpannya lebih lama sebelum dibersihkan.
LAPORAN_EVIDENCE_RETENTION_DAYS=0
LAPORAN_EVIDENCE_PURGE_SUPERSEDED=true
# Chrome headless membutuhkan HOME yang dapat ditulis.
HOME=/var/lib/laporan
