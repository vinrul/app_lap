# Salin ke /etc/laporan/laporan-jateng.env lalu sesuaikan.
# Instance Polda Jateng: port 4318 dan direktori data terpisah dari Polda Bali.
# Bila ingin memakai /home/laporan-data-jateng, ubah nilai di bawah, set
# ProtectHome=false pada service, dan samakan ReadWritePaths.
LAPORAN_DATA_DIR=/var/lib/laporan-jateng
LAPORAN_FRONTEND_DIR=/opt/laporan-jateng/frontend/dist
LAPORAN_PORT=4318
# Default loopback. Isi 0.0.0.0 hanya jika tidak memakai reverse proxy.
# LAPORAN_BIND_ADDR=127.0.0.1
# Saat bind non-loopback, batasi host yang boleh diakses (pisahkan dengan koma).
# LAPORAN_ALLOWED_HOSTS=laporan-jateng.example.go.id
LAPORAN_CHROME=/usr/bin/google-chrome-stable
# Tesseract untuk analisis dokumentasi (OCR watermark).
LAPORAN_TESSERACT=tesseract
# Opsional: sidecar PaddleOCR yang sama dengan instance Polda Bali.
# LAPORAN_PADDLE_URL=http://127.0.0.1:4320
LAPORAN_PADDLE_TIMEOUT_SECS=120
LAPORAN_SECURE_COOKIE=true
LAPORAN_POLDA_NAME=POLDA JATENG
# Polda Jateng memakai WIB, bukan WITA seperti Polda Bali.
LAPORAN_TIMEZONE_LABEL=WIB
# Peta laporan memakai profil Jawa Tengah.
LAPORAN_MAP_REGION=jateng
# Opsional. Logo instansi untuk web dan PDF. Bila kosong, dipakai
# <LAPORAN_DATA_DIR>/logo.png lalu logo bawaan aplikasi.
# LAPORAN_LOGO_PATH=/var/lib/laporan-jateng/logo.png
LAPORAN_MAX_UPLOAD_MB=32
LAPORAN_SESSION_HOURS=12
# Opsional. Wajib untuk tautan folder Google Drive publik.
# Isi API key asli hanya di /etc/laporan/laporan-jateng.env.
# LAPORAN_GOOGLE_DRIVE_API_KEY=
LAPORAN_EVIDENCE_RETENTION_DAYS=0
LAPORAN_EVIDENCE_PURGE_SUPERSEDED=true
# Chrome headless membutuhkan HOME yang dapat ditulis.
HOME=/var/lib/laporan-jateng
