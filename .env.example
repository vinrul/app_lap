# Salin berkas ini menjadi `.env` untuk pengembangan di Windows.
# `start.ps1` memuat variabel dari `.env`; berkas `.env` diabaikan Git.
# Jangan menulis kunci asli di berkas contoh ini.
#
# Nilai yang tidak diisi akan memakai bawaan start.ps1:
#   LAPORAN_DATA_DIR = <folder proyek>\data
#   LAPORAN_PORT     = 4317
#   LAPORAN_CHROME   = Edge di Program Files (x86)

LAPORAN_PORT=4317
LAPORAN_CHROME=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Path Tesseract untuk analisis dokumentasi. Isi bila tidak ada di PATH.
# LAPORAN_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# Sidecar PaddleOCR opsional. Jalankan paddle-ocr/ lalu aktifkan alamat ini.
# LAPORAN_PADDLE_URL=http://127.0.0.1:4320
# LAPORAN_PADDLE_TIMEOUT_SECS=120

# Opsional. Wajib bila workbook memakai tautan folder Google Drive publik.
LAPORAN_GOOGLE_DRIVE_API_KEY=
